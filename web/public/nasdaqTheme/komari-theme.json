{
    "name": "极光云控 (Aurora VPS)",
    "short": "nasdaq",
    "description": "基于 Next.js + Tailwind + Lucide 打造的顶级现代极光毛玻璃 VPS 云服务器集群运维监控大屏",
    "version": "3.0.0",
    "author": "Komari Aurora Studio",
    "url": "https://github.com/tonyliuzj/komari-next",
    "preview": "preview.png",
    "configuration": {
        "type": "managed",
        "name": {
            "zh-CN": "极光云控主题设置",
            "en-US": "Aurora VPS Settings"
        },
        "icon": "Server",
        "description": {
            "zh-CN": "极光云控 VPS 集群监控大盘配置与个性化选项",
            "en-US": "Aurora VPS Cluster Dashboard configuration options"
        },
        "data": [
            {
                "type": "title",
                "name": {
                    "zh-CN": "外观与动效配置",
                    "en-US": "Appearance & Effects"
                }
            },
            {
                "key": "colorTheme",
                "type": "select",
                "name": {
                    "zh-CN": "极光主题色系",
                    "en-US": "Aurora Color Theme"
                },
                "help": {
                    "zh-CN": "选择全站主色调方案（默认极光深邃蓝、赛博霓虹、星空幻紫、青翠森绿等）。",
                    "en-US": "Set default color scheme."
                },
                "default": "default",
                "options": "default,ocean,sunset,forest,midnight,rose"
            },
            {
                "key": "cardLayout",
                "type": "select",
                "name": {
                    "zh-CN": "节点卡片布局",
                    "en-US": "Node Card Layout"
                },
                "help": {
                    "zh-CN": "设置前台服务器节点卡片的默认排列展示模式。",
                    "en-US": "Default layout for server node cards."
                },
                "default": "compact",
                "options": "compact,classic,modern,minimal,detailed"
            },
            {
                "key": "cardBlurEnabled",
                "type": "switch",
                "name": {
                    "zh-CN": "启用毛玻璃背景模糊",
                    "en-US": "Enable Frosted Glass Blur"
                },
                "help": {
                    "zh-CN": "开启后卡片具有沉浸式半透明毛玻璃 HUD 视觉质感。",
                    "en-US": "Enable frosted glass HUD blur."
                },
                "default": true
            },
            {
                "key": "cardBlurType",
                "type": "select",
                "name": {
                    "zh-CN": "卡片模糊质感类型",
                    "en-US": "Glass Blur Type"
                },
                "default": "glass",
                "options": "glass,soft"
            },
            {
                "key": "cardBlurIntensity",
                "type": "number",
                "name": {
                    "zh-CN": "卡片透明度 (0-100)",
                    "en-US": "Card Transparency Intensity"
                },
                "default": 35
            },
            {
                "key": "cardExtraBlurIntensity",
                "type": "number",
                "name": {
                    "zh-CN": "背景模糊半径 (px)",
                    "en-US": "Blur Radius (px)"
                },
                "default": 24
            },
            {
                "key": "statusDesign",
                "type": "select",
                "name": {
                    "zh-CN": "状态指示灯风格",
                    "en-US": "Status Indicator Style"
                },
                "default": "speed",
                "options": "speed,default"
            },
            {
                "key": "graphDesign",
                "type": "select",
                "name": {
                    "zh-CN": "硬件图表仪表盘风格",
                    "en-US": "Hardware Gauge Design"
                },
                "default": "circle",
                "options": "circle,progress,bar,minimal"
            },
            {
                "key": "showRamDiskTotal",
                "type": "switch",
                "name": {
                    "zh-CN": "显示物理内存与磁盘绝对容量",
                    "en-US": "Show Absolute RAM and Disk Capacity"
                },
                "help": {
                    "zh-CN": "开启后同时显示 1.8G/2.0G 等具体物理容量，关闭则只显示百分比。",
                    "en-US": "Show actual capacity alongside percentages."
                },
                "default": true
            },
            {
                "key": "nodeViewMode",
                "type": "select",
                "name": {
                    "zh-CN": "默认视图模式",
                    "en-US": "Default View Mode"
                },
                "default": "grid",
                "options": "grid,table"
            },
            {
                "key": "appearance",
                "type": "select",
                "name": {
                    "zh-CN": "色彩明暗模式",
                    "en-US": "Color Mode"
                },
                "default": "dark",
                "options": "dark,light,system"
            },
            {
                "type": "title",
                "name": {
                    "zh-CN": "顶栏指标卡配置",
                    "en-US": "Status Cards Configuration"
                }
            },
            {
                "key": "statusCardsVisibility.currentTime",
                "type": "switch",
                "name": {
                    "zh-CN": "显示运维时钟与运行时间卡片",
                    "en-US": "Show Ops Clock Card"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.currentOnline",
                "type": "switch",
                "name": {
                    "zh-CN": "显示节点在线状态卡片",
                    "en-US": "Show Nodes Online Card"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.regionOverview",
                "type": "switch",
                "name": {
                    "zh-CN": "显示节点地域分布概览",
                    "en-US": "Show Regions Overview Card"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.trafficOverview",
                "type": "switch",
                "name": {
                    "zh-CN": "显示集群网络流量总览",
                    "en-US": "Show Traffic Overview Card"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.networkSpeed",
                "type": "switch",
                "name": {
                    "zh-CN": "显示实时出入网速卡片",
                    "en-US": "Show Network Speed Card"
                },
                "default": true
            },
            {
                "type": "title",
                "name": {
                    "zh-CN": "游客显示权限",
                    "en-US": "Guest Permissions"
                }
            },
            {
                "key": "guestDisplay.showPrice",
                "type": "switch",
                "name": {
                    "zh-CN": "向游客公开节点价格信息",
                    "en-US": "Show Prices to Guests"
                },
                "help": {
                    "zh-CN": "开启后，未登录访客也可以查看 VPS 节点的购入价格与续费周期。",
                    "en-US": "Allow guests to see node price and billing information."
                },
                "default": false
            },
            {
                "key": "guestDisplay.showExpiredAt",
                "type": "switch",
                "name": {
                    "zh-CN": "向游客公开服务器到期时间",
                    "en-US": "Show Expiration Dates to Guests"
                },
                "help": {
                    "zh-CN": "开启后，未登录访客也可以查看 VPS 到期时间与剩余天数。",
                    "en-US": "Allow guests to see node expiration dates."
                },
                "default": false
            }
        ]
    }
}